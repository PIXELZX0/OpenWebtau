<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\OpenUtau\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\..\vendor\OpenUtau\OpenUtau.Plugin.Builtin\OpenUtau.Plugin.Builtin.csproj" />
    <!-- The converter is plain C# with no Blazor in it, so the tests compile it directly
         instead of referencing the WebAssembly project. -->
    <Compile Include="..\..\src\OpenWebtau\Phonemizers\**\*.cs" LinkBase="Phonemizers" />
  </ItemGroup>

</Project>
