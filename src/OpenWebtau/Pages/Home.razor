@page "/"
@using System.Text.Json
@using NAudio.Wave
@using OpenUtau.Audio
@using OpenUtau.Core
@using OpenUtau.Core.Format
@using OpenUtau.Core.Ustx
@using OpenWebtau.Services
@inject IJSRuntime JS
@inject ProjectService Projects
@inject IAudioOutput Audio
@implements IAsyncDisposable

<PageTitle>OpenWebtau</PageTitle>

<div class="toolbar">
    <span class="brand">OpenWebtau</span>
    <button @onclick="NewProject">New</button>
    <label class="filebtn">
        Open
        <InputFile OnChange="OpenFile" accept=".ustx,.ust,.vsqx,.mid,.midi,.ufdata" />
    </label>
    <button @onclick="Save">Save</button>
    <span class="sep"></span>
    <button @onclick="PlayOrPause">@(playing ? "Pause" : "Play")</button>
    <button @onclick="Stop">Stop</button>
    <span class="sep"></span>
    <button @onclick="Undo">Undo</button>
    <button @onclick="Redo">Redo</button>
    <span class="sep"></span>
    <div class="modes">
        <button class="@(mode == "notes" ? "on" : "")" @onclick="@(() => SetMode("notes"))">Notes</button>
        <button class="@(mode == "pitch" ? "on" : "")" @onclick="@(() => SetMode("pitch"))">Pitch</button>
    </div>
    <label>Exp
        <select @onchange="OnExpChanged">
            @foreach (var d in Expressions) {
                <option value="@d.abbr" selected="@(d.abbr == expAbbr)">@d.abbr</option>
            }
        </select>
    </label>
    <span class="sep"></span>
    <label class="filebtn">
        Add singer
        <InputFile OnChange="InstallSinger" accept=".zip,.uar,.rar,.7z,.vogeon,.oudep" />
    </label>
    <label>Singer
        <select @onchange="OnSingerChanged">
            <option value="" selected="@(CurrentSinger == null)">(none)</option>
            @foreach (var singer in SingerManager.Inst.Singers.Values) {
                <option value="@singer.Id" selected="@(CurrentSinger?.Id == singer.Id)">@singer.Name</option>
            }
        </select>
    </label>
    <span class="sep"></span>
    <label>Snap
        <select @onchange="OnSnapChanged">
            @foreach (var (label, ticks) in SnapOptions) {
                <option value="@ticks" selected="@(ticks == snap)">@label</option>
            }
        </select>
    </label>
    <label>BPM
        <input type="number" min="10" max="600" value="@Bpm" @onchange="OnBpmChanged" />
    </label>
    <span class="status">@status</span>
</div>

<canvas @ref="canvas" class="pianoroll"></canvas>

<div class="hint">
    @if (mode == "pitch") {
        <span>Drag a point to bend · click the line to add one · right-click to delete · alt-click to change its shape · drag the pink handles for vibrato length and depth (shift for period)</span>
    } else {
        <span>Drag to draw · drag a note to move it · grab the right edge to resize · right-click to delete · double-click to edit the lyric · paint the bottom lane to tune @expAbbr</span>
    }
</div>

@if (install != null) {
    <div class="overlay">
        <div class="dialog">
            <h2>Installing voicebank</h2>
            <p class="filename">@install.FileName</p>
            <div class="bar">
                <div class="fill @(install.Indeterminate ? "indeterminate" : "")"
                     style="width:@(install.Indeterminate ? 100 : install.Percent)%"></div>
            </div>
            <p class="phase">@install.Phase</p>
        </div>
    </div>
}

@code {
    static readonly (string, int)[] SnapOptions = {
        ("1/4", 480), ("1/8", 240), ("1/16", 120), ("1/32", 60),
    };

    // Read in 256KB slices so the progress bar actually moves on large archives.
    const int UploadChunk = 256 * 1024;

    class InstallState {
        public string FileName = string.Empty;
        public string Phase = string.Empty;
        public int Percent;
        public bool Indeterminate;
    }

    ElementReference canvas;
    IJSObjectReference? rollModule;
    IJSObjectReference? appModule;
    DotNetObjectReference<Home>? selfRef;

    // Index into this snapshot is the note id handed to JS.
    List<UNote> noteIndex = new();
    int snap = 120;
    bool playing;
    string status = string.Empty;
    string mode = "notes";
    string expAbbr = Ustx.DYN;
    InstallState? install;
    CancellationTokenSource? playheadCts;

    UProject Project => DocManager.Inst.Project;
    double Bpm => Project.tempos.Count > 0 ? Project.tempos[0].bpm : 120;
    UTrack? Track => Project.tracks.FirstOrDefault();
    USinger? CurrentSinger => Track?.Singer;

    IEnumerable<UExpressionDescriptor> Expressions =>
        Project.expressions.Values.Where(d => !d.isFlag).OrderBy(d => d.abbr);

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;

        appModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/app.js");
        rollModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pianoroll.js");
        selfRef = DotNetObjectReference.Create(this);
        await rollModule.InvokeVoidAsync("init", canvas, selfRef);

        if (Audio is WebAudioOutput web) {
            await web.InitJsAsync();
        }

        Projects.Changed += OnProjectChanged;
        EnsurePart();
        await PushState();
    }

    void OnProjectChanged() {
        InvokeAsync(async () => {
            EnsurePart();
            await PushState();
            StateHasChanged();
        });
    }

    /// <summary>A brand new project has no part, and there is nothing to edit without one.</summary>
    UVoicePart EnsurePart() {
        var part = Project.parts.OfType<UVoicePart>().FirstOrDefault();
        if (part != null) return part;

        part = new UVoicePart { trackNo = 0, position = 0, Duration = Project.resolution * 4 * 8 };
        DocManager.Inst.StartUndoGroup();
        if (Project.tracks.Count == 0) {
            DocManager.Inst.ExecuteCmd(new AddTrackCommand(Project, new UTrack(Project) { TrackNo = 0 }));
        }
        DocManager.Inst.ExecuteCmd(new AddPartCommand(Project, part));
        DocManager.Inst.EndUndoGroup();
        return part;
    }

    // --- state to the piano roll ------------------------------------------

    async Task PushState() {
        var part = EnsurePart();
        noteIndex = part.notes.ToList();
        var state = new {
            resolution = Project.resolution,
            beatsPerBar = Project.timeSignatures[0].beatPerBar,
            beatUnit = Project.timeSignatures[0].beatUnit,
            playheadTick = DocManager.Inst.playPosTick,
            notes = noteIndex.Select((n, i) => NoteState(part, n, i)).ToList(),
            exp = ExpState(part),
        };
        await rollModule!.InvokeVoidAsync("setState", JsonSerializer.Serialize(state));
    }

    double NotePositionMs(UVoicePart part, UNote n)
        => Project.timeAxis.TickPosToMsPos(part.position + n.position);

    object NoteState(UVoicePart part, UNote n, int id) {
        double posMs = NotePositionMs(part, n);
        return new {
            id,
            pos = n.position + part.position,
            dur = n.duration,
            tone = n.tone,
            lyric = n.lyric,
            durMs = Project.timeAxis.TickPosToMsPos(part.position + n.position + n.duration) - posMs,
            // Pitch points are stored as milliseconds from the note start; the view
            // works in ticks, so convert here rather than teaching JS the time axis.
            pitch = (n.pitch?.data ?? new List<PitchPoint>()).Select(p => new {
                x = Project.timeAxis.MsPosToTickPos(posMs + p.X),
                y = p.Y / 10f,
                shape = p.shape.ToString(),
            }).ToList(),
            vib = n.vibrato == null || n.vibrato.length <= 0 ? null : new {
                len = n.vibrato.length,
                period = n.vibrato.period,
                depth = n.vibrato.depth,
                fadeIn = n.vibrato.@in,
                fadeOut = n.vibrato.@out,
                shift = n.vibrato.shift,
                drift = n.vibrato.drift,
            },
        };
    }

    object? ExpState(UVoicePart part) {
        if (!Project.expressions.TryGetValue(expAbbr, out var d)) return null;
        if (d.type == UExpressionType.Curve) {
            var curve = part.curves.FirstOrDefault(c => c.abbr == expAbbr);
            return new {
                abbr = d.abbr,
                type = "curve",
                min = d.min,
                max = d.max,
                defaultValue = d.CustomDefaultValue,
                xs = (curve?.xs ?? new List<int>()).Select(x => x + part.position).ToList(),
                ys = curve?.ys.ToList() ?? new List<int>(),
            };
        }
        var track = Track;
        var values = new Dictionary<string, float>();
        for (int i = 0; i < noteIndex.Count; i++) {
            var got = track == null ? null : noteIndex[i].GetExpression(Project, track, expAbbr).FirstOrDefault();
            values[i.ToString()] = got?.Item1 ?? d.CustomDefaultValue;
        }
        return new {
            abbr = d.abbr,
            type = "note",
            min = d.min,
            max = d.max,
            defaultValue = d.CustomDefaultValue,
            values,
        };
    }

    UNote? NoteById(int id) => id >= 0 && id < noteIndex.Count ? noteIndex[id] : null;

    // --- note edits from the piano roll -----------------------------------

    [JSInvokable]
    public async Task OnAddNote(int pos, int dur, int tone) {
        var part = EnsurePart();
        var note = Project.CreateNote(tone, pos - part.position, dur);
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new AddNoteCommand(part, note));
        GrowPartToFit(part, note.End);
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnRemoveNote(int id) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null) return;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new RemoveNoteCommand(part, note));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnMoveNotes(int[] ids, int deltaTick, int deltaTone) {
        var part = EnsurePart();
        var notes = ids.Select(NoteById).OfType<UNote>().ToList();
        if (notes.Count == 0) return;
        // Clamp so the leftmost note cannot be pushed before the part start.
        int minPos = notes.Min(n => n.position);
        deltaTick = Math.Max(deltaTick, -minPos);
        if (deltaTick == 0 && deltaTone == 0) return;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new MoveNoteCommand(part, notes, deltaTick, deltaTone));
        GrowPartToFit(part, notes.Max(n => n.End));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnResizeNotes(int[] ids, int deltaDur) {
        var part = EnsurePart();
        var notes = ids.Select(NoteById).OfType<UNote>().ToList();
        if (notes.Count == 0) return;
        // Never shrink a note below one snap unit.
        int minDur = notes.Min(n => n.duration);
        deltaDur = Math.Max(deltaDur, snap - minDur);
        if (deltaDur == 0) return;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new ResizeNoteCommand(part, notes, deltaDur));
        GrowPartToFit(part, notes.Max(n => n.End));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnEditLyric(int id) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null) return;
        var lyric = await appModule!.InvokeAsync<string?>("prompt", "Lyric", note.lyric);
        if (string.IsNullOrWhiteSpace(lyric) || lyric == note.lyric) return;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new ChangeNoteLyricCommand(part, note, lyric));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public void OnSeek(int tick) {
        DocManager.Inst.ExecuteCmd(new SeekPlayPosTickNotification(tick));
    }

    // --- tuning edits -----------------------------------------------------

    [JSInvokable]
    public async Task OnMovePitchPoint(int id, int index, double tick, double semitone) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null || index < 0 || index >= note.pitch.data.Count) return;
        var point = note.pitch.data[index];
        float x = (float)(Project.timeAxis.TickPosToMsPos(part.position + tick) - NotePositionMs(part, note));
        float y = (float)(semitone * 10);
        if (Math.Abs(x - point.X) < 0.01f && Math.Abs(y - point.Y) < 0.01f) return;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new MovePitchPointCommand(part, point, x - point.X, y - point.Y));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnAddPitchPoint(int id, int tick, double semitone) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null) return;
        float x = (float)(Project.timeAxis.TickPosToMsPos(part.position + tick) - NotePositionMs(part, note));
        int index = note.pitch.data.FindIndex(p => p.X > x);
        if (index < 0) index = note.pitch.data.Count;
        var shape = note.pitch.data.Count > 0
            ? note.pitch.data[Math.Max(0, index - 1)].shape
            : PitchPointShape.io;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new AddPitchPointCommand(
            part, note, new PitchPoint(x, (float)(semitone * 10), shape), index));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnDeletePitchPoint(int id, int index) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null) return;
        // The outer two points anchor where the portamento starts and ends; drop
        // them and there is no curve left to edit.
        if (index <= 0 || index >= note.pitch.data.Count - 1) return;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new DeletePitchPointCommand(part, note, index));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnCyclePitchShape(int id, int index) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null || index < 0 || index >= note.pitch.data.Count) return;
        var point = note.pitch.data[index];
        var order = new[] { PitchPointShape.io, PitchPointShape.l, PitchPointShape.i, PitchPointShape.o };
        var next = order[(Array.IndexOf(order, point.shape) + 1) % order.Length];

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new ChangePitchPointShapeCommand(part, point, next));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnSetVibrato(int id, float length, float depth, float period) {
        var part = EnsurePart();
        var note = NoteById(id);
        if (note == null) return;
        var vibrato = note.vibrato?.Clone() ?? new UVibrato();
        vibrato.length = length;
        vibrato.depth = depth;
        vibrato.period = period;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new SetVibratoCommand(part, note, vibrato));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnSetCurve(int tick, int value, int lastTick, int lastValue) {
        var part = EnsurePart();
        if (!Project.expressions.TryGetValue(expAbbr, out var d) || d.type != UExpressionType.Curve) return;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new SetCurveCommand(
            Project, part, expAbbr, tick - part.position, value, lastTick - part.position, lastValue));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    [JSInvokable]
    public async Task OnSetNoteExpression(int[] ids, float value) {
        var part = EnsurePart();
        var track = Track;
        if (track == null) return;
        var notes = ids.Select(NoteById).OfType<UNote>().ToList();
        if (notes.Count == 0) return;

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new SetNotesSameExpressionCommand(
            Project, track, part, notes, expAbbr, value));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    /// <summary>Must run inside an undo group; a part shorter than its notes renders truncated.</summary>
    void GrowPartToFit(UVoicePart part, int endTick) {
        if (endTick <= part.Duration) return;
        int bar = Project.resolution * 4 / Project.timeSignatures[0].beatUnit * Project.timeSignatures[0].beatPerBar;
        int target = (endTick / bar + 1) * bar;
        DocManager.Inst.ExecuteCmd(new ResizeVoicePartCommand(Project, part, target - part.Duration, false));
    }

    // --- toolbar ----------------------------------------------------------

    void NewProject() {
        Projects.NewProject();
    }

    async Task SetMode(string next) {
        mode = next;
        await rollModule!.InvokeVoidAsync("setMode", mode);
    }

    async Task OnExpChanged(ChangeEventArgs e) {
        expAbbr = e.Value?.ToString() ?? Ustx.DYN;
        await PushState();
    }

    async Task OpenFile(InputFileChangeEventArgs e) {
        var file = e.File;
        try {
            using var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            Projects.Open(file.Name, ms.ToArray());
            status = $"Opened {file.Name}";
        } catch (Exception ex) {
            status = $"Open failed: {ex.Message}";
            Serilog.Log.Error(ex, "Failed to open {Name}", file.Name);
        }
    }

    async Task Save() {
        var name = Path.GetFileNameWithoutExtension(Project.FilePath ?? "Untitled") + ".ustx";
        var bytes = Projects.SaveToUstx(name);
        await appModule!.InvokeVoidAsync("downloadBytes", name, Convert.ToBase64String(bytes), "application/x-yaml");
        status = $"Saved {name}";
    }

    async Task InstallSinger(InputFileChangeEventArgs e) {
        var file = e.File;
        install = new InstallState { FileName = file.Name, Phase = "Reading file..." };
        StateHasChanged();
        await Task.Yield();

        try {
            // Voicebanks are large; the default 512KB stream cap would truncate them.
            using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024 * 1024);
            using var ms = new MemoryStream();
            var buffer = new byte[UploadChunk];
            long done = 0;
            int read;
            while ((read = await stream.ReadAsync(buffer)) > 0) {
                ms.Write(buffer, 0, read);
                done += read;
                install.Percent = file.Size > 0 ? (int)(done * 100 / file.Size) : 0;
                install.Phase = $"Reading file... {install.Percent}%";
                StateHasChanged();
                // Hand the browser a chance to paint between slices.
                await Task.Delay(1);
            }

            // Extraction is synchronous inside Core and blocks the only thread, so
            // the bar cannot advance during it. Show it as indeterminate rather
            // than pretend to make progress.
            install.Indeterminate = true;
            install.Phase = "Extracting and loading...";
            StateHasChanged();
            await Task.Delay(30);

            Projects.InstallSinger(file.Name, ms.ToArray());
            status = $"Installed {file.Name}";
        } catch (Exception ex) {
            status = $"Install failed: {ex.Message}";
            Serilog.Log.Error(ex, "Failed to install singer {Name}", file.Name);
        } finally {
            install = null;
            StateHasChanged();
        }
    }

    void OnSingerChanged(ChangeEventArgs e) {
        var id = e.Value?.ToString();
        var singer = string.IsNullOrEmpty(id) ? null : SingerManager.Inst.GetSinger(id);
        var track = Track;
        if (track == null) return;
        // The default WORLDLINE-R renderer drives worldline's PhraseSynth API, which
        // passes a managed LogCallback into native code. The wasm interpreter cannot
        // marshal that reverse p/invoke and aborts the runtime. CLASSIC reaches the
        // same resampler through plain one-way calls.
        track.RendererSettings.renderer = OpenUtau.Core.Render.Renderers.CLASSIC;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new TrackChangeSingerCommand(Project, track, singer));
        DocManager.Inst.EndUndoGroup();
        status = singer == null ? "Singer cleared" : $"Singer: {singer.Name}";
    }

    void PlayOrPause() {
        PlaybackManager.Inst.PlayOrPause();
        playing = PlaybackManager.Inst.PlayingMaster;
        if (playing) StartPlayheadTimer(); else StopPlayheadTimer();
    }

    void Stop() {
        PlaybackManager.Inst.StopPlayback();
        playing = false;
        StopPlayheadTimer();
    }

    void Undo() {
        DocManager.Inst.Undo();
        InvokeAsync(PushState);
    }

    void Redo() {
        DocManager.Inst.Redo();
        InvokeAsync(PushState);
    }

    async Task OnSnapChanged(ChangeEventArgs e) {
        snap = int.Parse(e.Value?.ToString() ?? "120");
        await rollModule!.InvokeVoidAsync("setSnap", snap);
    }

    async Task OnBpmChanged(ChangeEventArgs e) {
        if (!double.TryParse(e.Value?.ToString(), out double bpm)) return;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new BpmCommand(Project, bpm));
        DocManager.Inst.EndUndoGroup();
        await PushState();
    }

    // PlaybackManager does not advance the play position on its own; the desktop app
    // pumps it from a UI timer and so must this. System.Threading.Timer is not an
    // option here: it fires on the thread pool, which never runs in single-threaded
    // wasm. Task.Delay resumes on the browser synchronization context.
    void StartPlayheadTimer() {
        StopPlayheadTimer();
        playheadCts = new CancellationTokenSource();
        _ = PlayheadLoopAsync(playheadCts.Token);
    }

    async Task PlayheadLoopAsync(CancellationToken token) {
        try {
            while (!token.IsCancellationRequested) {
                PlaybackManager.Inst.UpdatePlayPos();
                await rollModule!.InvokeVoidAsync("setPlayhead", DocManager.Inst.playPosTick);
                // The output stops itself once the rendered mix runs out, but
                // PlaybackManager keeps thinking it is playing until told otherwise.
                if (Audio.PlaybackState != PlaybackState.Playing) {
                    PlaybackManager.Inst.StopPlayback();
                    playing = false;
                    StateHasChanged();
                    return;
                }
                await Task.Delay(33, token);
            }
        } catch (OperationCanceledException) {
        } catch (Exception e) {
            Serilog.Log.Error(e, "Playhead loop stopped.");
        }
    }

    void StopPlayheadTimer() {
        playheadCts?.Cancel();
        playheadCts = null;
    }

    public async ValueTask DisposeAsync() {
        Projects.Changed -= OnProjectChanged;
        StopPlayheadTimer();
        selfRef?.Dispose();
        if (rollModule != null) await rollModule.DisposeAsync();
        if (appModule != null) await appModule.DisposeAsync();
    }
}
