    async Task ApplyLyrics() {
        var text = lyricDraft ?? string.Empty;
        lyricDraft = null;
        var words = text.Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        var notes = Selected.OrderBy(n => n.position).ToArray();
        if (words.Length == 0 || notes.Length == 0) return;

        // Fewer lyrics than notes just stops early, the way UTAU's lyric flow-in does.
        int count = Math.Min(words.Length, notes.Length);
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new ChangeNoteLyricCommand(
            EnsurePart(), notes.Take(count).ToArray(), words.Take(count).ToArray()));
        DocManager.Inst.EndUndoGroup();
        status = $"Set {count} lyric{(count == 1 ? "" : "s")}";
        await AfterEdit();
    }

