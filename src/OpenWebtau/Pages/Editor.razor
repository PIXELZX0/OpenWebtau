    [JSInvokable]
    public async Task OnPaste() {
        var clip = DocManager.Inst.NotesClipboard;
        if (clip == null || clip.Count == 0) return;
        var part = EnsurePart();
        int at = Math.Max(0, DocManager.Inst.playPosTick - part.position);
        var pasted = clip.Select(n => { var c = n.Clone(); c.position = n.position + at; return c; }).ToList();

        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new AddNoteCommand(part, pasted));
        GrowPartToFit(part, pasted.Max(n => n.End));
        DocManager.Inst.EndUndoGroup();
        await AfterEdit();

        // Select what was just pasted, so it can be nudged straight away.
        noteIndex = part.notes.ToList();
        selection = pasted.Select(n => noteIndex.IndexOf(n)).Where(i => i >= 0).ToList();
        await rollModule!.InvokeVoidAsync("setSelection", selection);
        status = $"Pasted {pasted.Count} note{(pasted.Count == 1 ? "" : "s")}";
    }

