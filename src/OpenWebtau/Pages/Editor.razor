    [JSInvokable]
    public Task OnCopy() {
        var notes = Selected;
        if (notes.Count == 0) return Task.CompletedTask;
        // Clone so later edits to the originals do not mutate what is on the clipboard.
        int origin = notes.Min(n => n.position);
        DocManager.Inst.NotesClipboard = notes
            .OrderBy(n => n.position)
            .Select(n => { var c = n.Clone(); c.position = n.position - origin; return c; })
            .ToList();
        status = $"Copied {notes.Count} note{(notes.Count == 1 ? "" : "s")}";
        StateHasChanged();
        return Task.CompletedTask;
    }

