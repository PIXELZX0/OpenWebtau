    async Task InstallSinger(InputFileChangeEventArgs e) {
        var file = e.File;
        install = new InstallState { FileName = file.Name, Phase = "Reading file..." };
        StateHasChanged();
        await Task.Yield();

        try {
            // Voicebanks are large; the default 512KB stream cap would truncate them.
            using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024 * 1024);
            using var ms = new MemoryStream();
            var buffer = new byte[UploadChunk];
            long done = 0;
            int read;
            while ((read = await stream.ReadAsync(buffer)) > 0) {
                ms.Write(buffer, 0, read);
                done += read;
                install.Percent = file.Size > 0 ? (int)(done * 100 / file.Size) : 0;
                install.Phase = $"Reading file... {install.Percent}%";
                StateHasChanged();
                // Hand the browser a chance to paint between slices.
                await Task.Delay(1);
            }

            install.Pending = ms.ToArray();
            install.Phase = string.Empty;
        } catch (Exception ex) {
            status = $"Install failed: {ex.Message}";
            Serilog.Log.Error(ex, "Failed to read singer {Name}", file.Name);
            install = null;
        }
        StateHasChanged();
    }

    async Task FinishInstall() {
        if (install?.Pending is not byte[] bytes) return;
        var fileName = install.FileName;
        install.Pending = null;
        // Extraction is synchronous inside Core and blocks the only thread, so
        // the bar cannot advance during it. Show it as indeterminate rather
        // than pretend to make progress.
        install.Indeterminate = true;
        install.Phase = "Extracting and loading...";
        StateHasChanged();
        await Task.Delay(30);

        try {
            var before = SingerManager.Inst.Singers.Keys.ToHashSet();
            Projects.InstallSinger(fileName, bytes, installEncoding);
            // The wasm VFS dies with the tab; archive the upload so startup can
            // reinstall the bank and singers survive a reload.
            await Store.SaveSingerArchiveAsync(fileName, bytes, installEncoding);
            status = $"Installed {fileName}";

            // First bank for this track: use it, so the next Play is not silent.
            var added = SingerManager.Inst.Singers.Values.FirstOrDefault(x => !before.Contains(x.Id));
            if (added != null && Track is UTrack t && t.Singer == null) {
                OnSingerChanged(t, new ChangeEventArgs { Value = added.Id });
            }
        } catch (Exception ex) {
            status = $"Install failed: {ex.Message}";
            Serilog.Log.Error(ex, "Failed to install singer {Name}", fileName);
        } finally {
            install = null;
            StateHasChanged();
        }
    }

