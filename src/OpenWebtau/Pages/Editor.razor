@page "/edit/{Id}"
@using System.Text.Json
@using NAudio.Wave
@using OpenUtau.Audio
@using OpenUtau.Api
@using OpenUtau.Core
@using OpenUtau.Core.Format
@using OpenUtau.Core.Ustx
@using OpenWebtau.Phonemizers
@using OpenWebtau.Services
@inject IJSRuntime JS
@inject ProjectService Projects
@inject IAudioOutput Audio
@inject ProjectStore Store
@inject Dialogs Dialogs
@inject NavigationManager Nav
@inject SingerArchiveService SingerArchives
@implements IAsyncDisposable

<PageTitle>@projectName · OpenWebtau</PageTitle>

<div class="toolbar">
    <a class="brand" href="/" title="All projects">‹ OpenWebtau</a>
    <button class="title" @onclick="RenameProject" title="Rename project">@projectName</button>
    <span class="sep"></span>
    <button @onclick="PlayOrPause" title="Play / pause (Space)">@(playing ? "Pause" : "Play")</button>
    <button @onclick="Stop" title="Stop">Stop</button>
    <span class="sep"></span>
    <button @onclick="Undo" title="Undo (Ctrl+Z)">Undo</button>
    <button @onclick="Redo" title="Redo (Ctrl+Y)">Redo</button>
    <span class="sep"></span>
    <div class="modes">
        <button class="@(mode == "notes" ? "on" : "")" @onclick="@(() => SetMode("notes"))" title="Draw and edit notes">Notes</button>
        <button class="@(mode == "pitch" ? "on" : "")" @onclick="@(() => SetMode("pitch"))" title="Edit portamento and vibrato (UTAU mode 2)">Pitch</button>
    </div>
    <label title="Which parameter the bottom lane paints">Lane
        <select @onchange="OnExpChanged">
            @foreach (var d in Expressions) {
                <option value="@d.abbr" selected="@(d.abbr == expAbbr)">@ExpLabel(d)</option>
            }
        </select>
    </label>
    <span class="sep"></span>
    <label>Snap
        <select @onchange="OnSnapChanged">
            @foreach (var (label, ticks) in SnapOptions) {
                <option value="@ticks" selected="@(ticks == snap)">@label</option>
            }
        </select>
    </label>
    <label>BPM
        <input type="number" min="10" max="600" value="@Bpm" @onchange="OnBpmChanged" />
    </label>
    <span class="sep"></span>
    <button @onclick="Download" title="OpenUtau project, every track">Export .ustx</button>
    <button @onclick="ExportUst" title="Classic UTAU file, current track only">Export .ust</button>
    <button @onclick="ExportWav">Export .wav</button>
    <button class="agent @agentState" @onclick="ToggleAgent"
            title="Let an AI agent edit this project through the OpenWebtau MCP server (mcp/server.mjs)">
        Agent: @(agentState == "on" ? "connected" : agentState == "waiting" ? "waiting…" : "off")
    </button>
    <span class="status">@status</span>
</div>

<div class="workspace">
    <aside class="tracks">
        <div class="tracks-head">
            <span>Tracks</span>
            <button @onclick="AddTrack" title="Add an empty track">+</button>
        </div>
        <div class="track-list">
            @for (int i = 0; i < Project.tracks.Count; i++) {
                var index = i;
                var track = Project.tracks[i];
                <div class="track @(index == trackIndex ? "on" : "")" @onclick="@(() => SelectTrack(index))">
                    <div class="track-top">
                        <span class="track-name" @onclick:stopPropagation @onclick="@(() => RenameTrack(track))"
                              title="Rename track">@track.TrackName</span>
                        <button class="@(track.Mute ? "flag on" : "flag")" title="Mute"
                                @onclick:stopPropagation @onclick="@(() => ToggleMute(track))">M</button>
                        <button class="@(track.Solo ? "flag on" : "flag")" title="Solo"
                                @onclick:stopPropagation @onclick="@(() => ToggleSolo(track))">S</button>
                        <button class="flag danger" title="Remove track"
                                @onclick:stopPropagation @onclick="@(() => RemoveTrack(track))">×</button>
                    </div>
                    <select @onclick:stopPropagation @onchange="@(e => OnSingerChanged(track, e))">
                        <option value="" selected="@(track.Singer == null)">(no singer)</option>
                        @foreach (var singer in SingerManager.Inst.Singers.Values) {
                            <option value="@singer.Id" selected="@(track.Singer?.Id == singer.Id)">@singer.Name</option>
                        }
                    </select>
                    <select title="Phonemizer: turns lyrics into the bank's aliases (CV, VCV, CVVC, Korean, English...)"
                            @onclick:stopPropagation @onchange="@(e => OnPhonemizerChanged(track, e))">
                        @foreach (var f in PhonemizerFactory.GetAll()) {
                            <option value="@f.type.FullName" selected="@(track.Phonemizer?.GetType() == f.type)">[@f.tag] @f.name</option>
                        }
                    </select>
                    <label class="mix" @onclick:stopPropagation>
                        <span>Vol</span>
                        <input type="range" min="-24" max="12" step="1" value="@track.Volume"
                               @onchange="@(e => SetVolume(track, e))" />
                    </label>
                    <label class="mix" @onclick:stopPropagation>
                        <span>Pan</span>
                        <input type="range" min="-100" max="100" step="1" value="@track.Pan"
                               @onchange="@(e => SetPan(track, e))" />
                    </label>
                </div>
            }
        </div>
        <div class="tracks-foot">
            <label class="filebtn">
                Import tracks
                <InputFile OnChange="ImportTracks" multiple accept=".ustx,.ust,.vsqx,.mid,.midi,.ufdata" />
            </label>
            <label class="filebtn" title="A UTAU voicebank archive (.zip, .uar, .rar, .7z). It stays in this browser.">
                Install voicebank
                <InputFile OnChange="InstallSinger" accept=".zip,.uar,.rar,.7z,.vogeon,.oudep" />
            </label>
        </div>
    </aside>

    <div class="stage">
        @if (SingerManager.Inst.Singers.Count == 0) {
            <div class="banner">
                <span>No voicebank installed yet — notes will stay silent.</span>
                <label class="filebtn primary">
                    Install a UTAU voicebank
                    <InputFile OnChange="InstallSinger" accept=".zip,.uar,.rar,.7z,.vogeon,.oudep" />
                </label>
            </div>
        } else if (Track is UTrack current && current.Singer == null) {
            <div class="banner">
                <span>@current.TrackName has no singer.</span>
                <select @onchange="@(e => OnSingerChanged(current, e))">
                    <option value="" selected>Choose a voicebank…</option>
                    @foreach (var singer in SingerManager.Inst.Singers.Values) {
                        <option value="@singer.Id">@singer.Name</option>
                    }
                </select>
            </div>
        }
        <canvas @ref="canvas" class="pianoroll"></canvas>
    </div>

    @if (selection.Count > 0) {
        <aside class="props">
            <div class="props-head">@selection.Count note@(selection.Count == 1 ? "" : "s") selected</div>

            <section>
                <h3>Lyrics</h3>
                <button @onclick="OpenLyricDialog">Enter lyrics…</button>
            </section>

            <section>
                <h3>Note properties</h3>
                @foreach (var (abbr, label) in NoteProps) {
                    if (!Project.expressions.TryGetValue(abbr, out var d)) continue;
                    <label class="row" title="@d.name (@d.min – @d.max)">
                        <span>@label</span>
                        <input type="number" step="1" min="@d.min" max="@d.max"
                               value="@NoteExpValue(abbr, d)"
                               @onchange="@(e => SetNoteProp(abbr, e))" />
                    </label>
                }
            </section>

            <section>
                <h3>Portamento</h3>
                <div class="row shapes">
                    @foreach (var shape in PitchShapes) {
                        <button @onclick="@(() => SetPitchShape(shape))">@ShapeLabel(shape)</button>
                    }
                </div>
                <button @onclick="ResetPitch">Reset curve</button>
            </section>

            <section>
                <h3>Vibrato</h3>
                @foreach (var f in VibratoFields) {
                    <label class="row">
                        <span>@f.Label</span>
                        <input type="number" step="1" min="@f.Min" max="@f.Max"
                               value="@f.Get(FirstVibrato)"
                               @onchange="@(e => SetVibratoField(f, e))" />
                    </label>
                }
                <button @onclick="ClearVibrato">Remove vibrato</button>
            </section>

            @if (SingleNote is UNote one) {
                <section>
                    <h3>Phonemes</h3>
                    @{ var phonemes = PhonemesOf(one); }
                    @if (phonemes.Count == 0) {
                        <p class="muted">None yet — assign a singer.</p>
                    }
                    @for (int i = 0; i < phonemes.Count; i++) {
                        var idx = i;
                        var ph = phonemes[i];
                        <div class="phoneme">
                            <label class="row">
                                <span>Alias</span>
                                <input value="@ph.phoneme" @onchange="@(e => SetAlias(one, idx, e))" />
                            </label>
                            <label class="row">
                                <span title="Start point: skips this many ms of the sample">STP</span>
                                <input type="number" step="5" value="@(one.GetPhonemeOverride(idx).offset ?? 0)"
                                       @onchange="@(e => SetPhonemeOffset(one, idx, e))" />
                            </label>
                            <label class="row">
                                <span title="Pre-utterance delta in ms (先行発声)">Pre-utt.</span>
                                <input type="number" step="5" value="@(one.GetPhonemeOverride(idx).preutterDelta ?? 0)"
                                       @onchange="@(e => SetPreutter(one, idx, ph, e))" />
                            </label>
                            <label class="row">
                                <span title="Overlap delta in ms (オーバーラップ)">Overlap</span>
                                <input type="number" step="5" value="@(one.GetPhonemeOverride(idx).overlapDelta ?? 0)"
                                       @onchange="@(e => SetOverlap(one, idx, ph, e))" />
                            </label>
                        </div>
                    }
                </section>
            }
        </aside>
    }
</div>

<div class="hint">
    @if (selection.Count > 0) {
        <span>Ctrl+C/X/V copy, cut, paste at the playhead · Delete removes · arrows nudge (shift = octave, alt = resize) · Ctrl+A all · Esc clears</span>
    } else if (mode == "pitch") {
        <span>Drag a point to bend · click the line to add one · right-click to delete · alt-click to change its shape · drag the pink handles for vibrato length and depth (shift for period)</span>
    } else {
        <span>Drag to draw · drag a note to move it · grab the right edge to resize · right-click to delete · double-click to edit the lyric · paint the bottom lane to tune @expAbbr</span>
    }
</div>

@if (lyricDraft != null) {
    <div class="overlay">
        <div class="dialog">
            <h2>Enter lyrics</h2>
            <p class="filename">One per line, or separated by spaces. They fill the selected notes in order.</p>
            <textarea rows="8" @bind="lyricDraft" @bind:event="oninput"></textarea>
            <div class="dialog-actions">
                <button @onclick="@(() => lyricDraft = null)">Cancel</button>
                <button class="primary" @onclick="ApplyLyrics">Apply</button>
            </div>
        </div>
    </div>
}

@if (install != null) {
    <div class="overlay">
        <div class="dialog">
            <h2>Installing voicebank</h2>
            <p class="filename">@install.FileName</p>
            @if (install.Pending != null) {
                <label class="row">
                    <span>Text encoding</span>
                    <select @bind="installEncoding">
                        @foreach (var (label, name) in Encodings) {
                            <option value="@name">@label</option>
                        }
                    </select>
                </label>
                <p class="muted">Pick the language the bank was made in. A wrong choice shows garbled file names and aliases that never match.</p>
                <div class="dialog-actions">
                    <button @onclick="@(() => install = null)">Cancel</button>
                    <button class="primary" @onclick="FinishInstall">Install</button>
                </div>
            } else {
            <div class="bar">
                <div class="fill @(install.Indeterminate ? "indeterminate" : "")"
                     style="width:@(install.Indeterminate ? 100 : install.Percent)%"></div>
            </div>
            <p class="phase">@install.Phase</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    static readonly (string, int)[] SnapOptions = {
        ("1/4", 480), ("1/8", 240), ("1/16", 120), ("1/32", 60),
    };

    // Read in 256KB slices so the progress bar actually moves on large archives.
    const int UploadChunk = 256 * 1024;
    // Edits arrive in bursts while dragging; wait for the burst to end before saving.
    const int AutoSaveDelayMs = 1200;

    class InstallState {
        public string FileName = string.Empty;
        public string Phase = string.Empty;
        public int Percent;
        public bool Indeterminate;
        /// Read but not yet extracted, waiting on the encoding choice.
        public byte[]? Pending;
    }

    static readonly (string, string)[] Encodings = {
        ("Japanese (Shift-JIS)", "shift_jis"),
        ("Korean (CP949)", "ks_c_5601-1987"),
        ("Chinese (GBK)", "gbk"),
        ("UTF-8", "utf-8"),
    };
    // Remembered for the session: people install several banks of one language.
    static string installEncoding = "shift_jis";

    /// UTAU's note property dialog, as OpenUtau expressions. Flag letters are what
    /// UTAU users type into the flags box.
    static readonly (string, string)[] NoteProps = {
        (Ustx.VEL, "Velocity"), (Ustx.VOL, "Intensity"), (Ustx.MOD, "Modulation"),
        (Ustx.GEN, "g (gender)"), (Ustx.BRE, "B (breath)"), (Ustx.LPF, "H (lowpass)"),
    };

    ElementReference canvas;
    IJSObjectReference? rollModule;
    DotNetObjectReference<Editor>? selfRef;

    // Index into this snapshot is the note id handed to JS.
    List<UNote> noteIndex = new();
    int snap = 120;
    int trackIndex;
    bool playing;
    string status = string.Empty;
    string mode = "notes";
    string expAbbr = Ustx.DYN;
    string projectName = "Untitled";
    InstallState? install;
    List<int> selection = new();
    string? lyricDraft;
    CancellationTokenSource? playheadCts;
    CancellationTokenSource? autoSaveCts;

    UProject Project => DocManager.Inst.Project;
    double Bpm => Project.tempos.Count > 0 ? Project.tempos[0].bpm : 120;
    UTrack? Track => trackIndex >= 0 && trackIndex < Project.tracks.Count ? Project.tracks[trackIndex] : null;

    static readonly OpenUtau.Classic.ClassicRenderer Classic = new();

    // Tracks are pinned to CLASSIC, so list only what it renders. Options (clr, eng,
    // dir) have no numeric lane to paint.
    IEnumerable<UExpressionDescriptor> Expressions =>
        Project.expressions.Values
            .Where(d => d.type != UExpressionType.Options && Classic.SupportsExpression(d))
            .OrderBy(d => d.abbr);

    static string ExpLabel(UExpressionDescriptor d) =>
        string.IsNullOrEmpty(d.flag) ? $"{d.abbr} · {d.name}" : $"{d.abbr} · {d.name} ({d.flag} flag)";

    protected override async Task OnInitializedAsync() {
        var summary = (await Store.ListAsync()).FirstOrDefault(p => p.Id == Id);
        projectName = summary?.Name ?? "Untitled";
        // Reinstall archived voicebanks before parsing the stored project so its
        // singer references resolve on a fresh page load.
        await SingerArchives.EnsureRestoredAsync(Store, Projects);
        if (summary != null) {
            try {
                await Store.OpenAsync(Id);
            } catch (Exception e) {
                // A stored project that fails to parse (e.g. written by a newer
                // version) should not brick the editor; start clean instead.
                Serilog.Log.Error(e, "Failed to open project {Id}", Id);
                status = "Could not load the saved project — started a blank one.";
                Projects.NewProject();
                await Store.SaveAsync(Id, projectName, Project);
            }
        } else {
            // Unknown id, most likely a stale link. Start clean rather than quietly
            // editing whatever project happened to be loaded.
            Projects.NewProject();
            await Store.SaveAsync(Id, projectName, Project);
        }
        // Restore fires Changed mid-boot; without this gate the editor can push the
        // still-blank default project to the canvas and never refresh.
        loaded = true;
        await TryInitialPush();
    }

    bool ready;
    bool loaded;

    /// <summary>First state push, once BOTH js init and project load have finished.</summary>
    Task TryInitialPush() => ready && loaded ? PushState() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;

        rollModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pianoroll.js");
        selfRef = DotNetObjectReference.Create(this);
        await rollModule.InvokeVoidAsync("init", canvas, selfRef);

        if (Audio is WebAudioOutput web) {
            await web.InitJsAsync();
        }

        Projects.Changed += OnProjectChanged;
        EnsurePart();
        ready = true;
        await TryInitialPush();
        await ResumeAgent();
    }

    void OnProjectChanged() {
        if (!loaded) return;
        InvokeAsync(async () => {
            trackIndex = Math.Clamp(trackIndex, 0, Math.Max(0, Project.tracks.Count - 1));
            EnsurePart();
            await PushState();
            StateHasChanged();
        });
    }

    // --- tracks and parts -------------------------------------------------

    /// <summary>
    /// Every track edits through one voice part. A track without one has nothing to
    /// draw into, so make it on demand.
    /// </summary>
    UVoicePart EnsurePart() {
        if (Project.tracks.Count == 0) {
            DocManager.Inst.StartUndoGroup();
            DocManager.Inst.ExecuteCmd(new AddTrackCommand(Project, NewTrack(0)));
            DocManager.Inst.EndUndoGroup();
            trackIndex = 0;
        }
        trackIndex = Math.Clamp(trackIndex, 0, Project.tracks.Count - 1);

        var part = Project.parts.OfType<UVoicePart>().FirstOrDefault(p => p.trackNo == trackIndex);
        if (part != null) return part;

        part = new UVoicePart {
            trackNo = trackIndex,
            position = 0,
            Duration = Project.resolution * 4 * 8,
            name = Project.tracks[trackIndex].TrackName,
        };
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new AddPartCommand(Project, part));
        DocManager.Inst.EndUndoGroup();
        return part;
    }

    async Task SelectTrack(int index) {
        if (index == trackIndex) return;
        trackIndex = index;
        EnsurePart();
        await PushState();
    }

    static PhonemizerFactory AutoFactory => PhonemizerFactory.Get(typeof(AutoPhonemizer))!;

    UTrack NewTrack(int trackNo) => new UTrack(Project) { TrackNo = trackNo, Phonemizer = AutoFactory.Create() };

    async Task AddTrack() {
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new AddTrackCommand(Project, NewTrack(Project.tracks.Count)));
        DocManager.Inst.EndUndoGroup();
        trackIndex = Project.tracks.Count - 1;
        EnsurePart();
        await PushState();
        QueueAutoSave();
    }

    async Task RemoveTrack(UTrack track, bool confirm = true) {
        if (Project.tracks.Count <= 1) {
            status = "A project needs at least one track";
            return;
        }
        if (confirm && !await Dialogs.ConfirmAsync($"Remove \"{track.TrackName}\" and its notes?")) return;

        DocManager.Inst.StartUndoGroup();
        // Parts hold a track index, so drop this track's parts before the track goes.
        foreach (var part in Project.parts.Where(p => p.trackNo == track.TrackNo).ToList()) {
            DocManager.Inst.ExecuteCmd(new RemovePartCommand(Project, part));
        }
        DocManager.Inst.ExecuteCmd(new RemoveTrackCommand(Project, track));
        DocManager.Inst.EndUndoGroup();

        trackIndex = Math.Clamp(trackIndex, 0, Project.tracks.Count - 1);
        EnsurePart();
        await PushState();
        QueueAutoSave();
    }

    async Task RenameTrack(UTrack track) {
        var name = await Dialogs.PromptAsync("Track name", track.TrackName);
        if (string.IsNullOrWhiteSpace(name) || name == track.TrackName) return;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new RenameTrackCommand(Project, track, name));
        DocManager.Inst.EndUndoGroup();
        QueueAutoSave();
    }

    void ToggleMute(UTrack track) {
        // Mute and solo are playback state, not document history; OpenUtau does not
        // put them on the undo stack either.
        track.Mute = !track.Mute;
        QueueAutoSave();
    }

    void ToggleSolo(UTrack track) {
        track.Solo = !track.Solo;
        QueueAutoSave();
    }

    void OnSingerChanged(UTrack track, ChangeEventArgs e) {
        var id = e.Value?.ToString();
        var singer = string.IsNullOrEmpty(id) ? null : SingerManager.Inst.GetSinger(id);
        // The default WORLDLINE-R renderer drives worldline's PhraseSynth API, which
        // passes a managed LogCallback into native code. The wasm interpreter cannot
        // marshal that reverse p/invoke and aborts the runtime. CLASSIC reaches the
        // same resampler through plain one-way calls.
        track.RendererSettings.renderer = OpenUtau.Core.Render.Renderers.CLASSIC;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new TrackChangeSingerCommand(Project, track, singer));
        // Auto picks the phonemizer per lyric (Hangul, kana, Latin) and routes the bank's own
        // language to the phonemizer its character.yaml names, so no manual choice is needed.
        if (singer != null && track.Phonemizer is not AutoPhonemizer) {
            DocManager.Inst.ExecuteCmd(new TrackChangePhonemizerCommand(Project, track, AutoFactory.Create()));
        }
        DocManager.Inst.EndUndoGroup();
        status = singer == null ? $"{track.TrackName}: no singer" : $"{track.TrackName}: {singer.Name}";
        QueueAutoSave();
    }

    void OnPhonemizerChanged(UTrack track, ChangeEventArgs e) {
        if (PhonemizerFactory.Get(e.Value?.ToString() ?? "") is not PhonemizerFactory f) return;
        DocManager.Inst.StartUndoGroup();
        DocManager.Inst.ExecuteCmd(new TrackChangePhonemizerCommand(Project, track, f.Create()));
        DocManager.Inst.EndUndoGroup();
        status = $"{track.TrackName}: [{f.tag}] {f.name}";
        QueueAutoSave();
    }

    async Task ImportTracks(InputFileChangeEventArgs e) {
        var files = e.GetMultipleFiles(maximumFileCount: 32);
        var paths = new List<string>();
        try {
            Directory.CreateDirectory("/tmp/import");
            foreach (var file in files) {
                using var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var path = Path.Combine("/tmp/import", file.Name);
                File.WriteAllBytes(path, ms.ToArray());
                paths.Add(path);
            }
            // Keep this project's tempo; the imported files only contribute tracks.
            Formats.ImportTracks(Project, paths.ToArray(), importTempo: false);
            trackIndex = Project.tracks.Count - 1;
            EnsurePart();
            await PushState();
            status = $"Imported {paths.Count} file{(paths.Count == 1 ? "" : "s")}";
            QueueAutoSave();
        } catch (Exception ex) {
            status = $"Import failed: {ex.Message}";
            Serilog.Log.Error(ex, "Failed to import tracks");
        } finally {
            foreach (var path in paths) {
                try { File.Delete(path); } catch { }
            }
        }
    }

    // --- state to the piano roll ------------------------------------------

    async Task PushState() {
        if (!ready || rollModule == null) return;
        var part = EnsurePart();
        noteIndex = part.notes.ToList();
        var state = new {
            resolution = Project.resolution,
            beatsPerBar = Project.timeSignatures[0].beatPerBar,
            beatUnit = Project.timeSignatures[0].beatUnit,
            playheadTick = DocManager.Inst.playPosTick,
            rangeStart = DocManager.Inst.rangeStartTick,
            rangeEnd = DocManager.Inst.rangeEndTick,
            notes = noteIndex.Select((n, i) => NoteState(part, n, i)).ToList(),
            ghosts = GhostNotes(part),
            exp = ExpState(part),
        };
        await rollModule.InvokeVoidAsync("setState", JsonSerializer.Serialize(state));
    }

    /// <summary>Other tracks' notes, drawn dim so the arrangement stays visible.</summary>
    List<object> GhostNotes(UVoicePart current) {
        var list = new List<object>();
        foreach (var part in Project.parts.OfType<UVoicePart>()) {
            if (part == current) continue;
            foreach (var n in part.notes) {
                list.Add(new { pos = n.position + part.position, dur = n.duration, tone = n.tone });
            }
        }
        return list;
    }

    double NotePositionMs(UVoicePart part, UNote n)
        => Project.timeAxis.TickPosToMsPos(part.position + n.position);

    object NoteState(UVoicePart part, UNote n, int id) {
        double posMs = NotePositionMs(part, n);
        return new {
            id,
            pos = n.position + part.position,
            dur = n.duration,
            tone = n.tone,
            lyric = n.lyric,
            durMs = Project.timeAxis.TickPosToMsPos(part.position + n.position + n.duration) - posMs,
            // Pitch points are stored as milliseconds from the note start; the view
            // works in ticks, so convert here rather than teaching JS the time axis.
            pitch = (n.pitch?.data ?? new List<PitchPoint>()).Select(p => new {
                x = Project.timeAxis.MsPosToTickPos(posMs + p.X),
                y = p.Y / 10f,
                shape = p.shape.ToString(),
            }).ToList(),
            vib = n.vibrato == null || n.vibrato.length <= 0 ? null : new {
                len = n.vibrato.length,
                period = n.vibrato.period,
                depth = n.vibrato.depth,
                fadeIn = n.vibrato.@in,
                fadeOut = n.vibrato.@out,
                shift = n.vibrato.shift,
                drift = n.vibrato.drift,
            },
        };
    }

    object? ExpState(UVoicePart part) {
        if (!Project.expressions.TryGetValue(expAbbr, out var d)) return null;
        if (d.type == UExpressionType.Curve) {
            var curve = part.curves.FirstOrDefault(c => c.abbr == expAbbr);
            return new {
                abbr = d.abbr,
                type = "curve",
                min = d.min,
                max = d.max,
                defaultValue = d.CustomDefaultValue,
                xs = (curve?.xs ?? new List<int>()).Select(x => x + part.position).ToList(),
                ys = curve?.ys.ToList() ?? new List<int>(),
            };
        }
        var track = Track;
        var values = new Dictionary<string, float>();
        for (int i = 0; i < noteIndex.Count; i++) {
            var got = track == null ? null : noteIndex[i].GetExpression(Project, track, expAbbr).FirstOrDefault();
            values[i.ToString()] = got?.Item1 ?? d.CustomDefaultValue;
        }
        return new {
            abbr = d.abbr,
            type = "note",
            min = d.min,
            max = d.max,
            defaultValue = d.CustomDefaultValue,
            values,
        };
    }

