<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.6" PrivateAssets="all" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- RuntimeIdentifier does not flow across ProjectReference, so tell Core
         explicitly that it is being built for the browser. -->
    <ProjectReference Include="..\..\vendor\OpenUtau\OpenUtau.Core\OpenUtau.Core.csproj"
                      AdditionalProperties="OpenUtauTargetsBrowser=true" />
    <ProjectReference Include="..\..\vendor\OpenUtau\OpenUtau.Plugin.Builtin\OpenUtau.Plugin.Builtin.csproj"
                      AdditionalProperties="OpenUtauTargetsBrowser=true" />
  </ItemGroup>

  <!-- Statically links the worldline resampler so Core's [DllImport("worldline")]
       resolves. Build it first with native/build-worldline.sh. -->
  <PropertyGroup>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- A Debug relink defaults to -O0, which pulls the debug sysroot libraries
         (-lc-debug, -lstubs-debug). That runtime aborts with a bare ExitStatus on
         the first zip extraction. Link optimized in every configuration. -->
    <EmccLinkOptimizationFlag>-O2</EmccLinkOptimizationFlag>
    <!-- OpenUtau.Core pulls System.Text.Json 9, which reads nullability info when
         deserializing records. Trimmed publishes switch that off by default, and
         every interop call returning a record then throws
         NullabilityInfoContext_NotSupported. -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
  </PropertyGroup>

  <ItemGroup>
    <NativeFileReference Include="..\..\native\worldline.a" />
  </ItemGroup>

</Project>
